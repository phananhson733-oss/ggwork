{
  "about": [
    "Status banners per channel (plan TR-10, D10; design 3.7, 4.10). Python ggwork_pick.observe.status_rules and the data page's",
    "TS copy (TR-24/TR-25 obs-banner-rules.ts) both reproduce every case; now is always explicit.",
    "Input per case: the channel, now, the current live set's published_at (null: no live set) and the channel's latest run by",
    "started_at (a pick_obs.run_status row, only the fields that decide a banner; null: the channel never ran).",
    "Banners: every status code of the latest run (collectors write them, including a refusal such as disabled_7d or",
    "canary_terminated as a run row of its own), plus three computed from time: stale_26h (Trends only: now - live",
    "published_at > 26 h; exactly 26 h is not stale; no live set, no stale_26h), run_missed (Trends: from 02:30 UTC the due",
    "target date is today, before it yesterday, and the latest run's target_date is earlier than the due date; GSC: now -",
    "latest started_at > 4 h; exactly 4 h is not missed; a channel that never ran has no run_missed) and shadow_mode (the",
    "latest run's mode is shadow). Each code once, ordered by level (red, warn, info) and then by STATUS_CODES order.",
    "levels and texts are the code -> level and code -> banner text tables; both sides read them from here."
  ],
  "params": {
    "trends_stale_hours": 26,
    "trends_due_utc": "02:30",
    "gsc_missed_hours": 4
  },
  "levels": {
    "stale_26h": "red",
    "not_published_low_coverage": "red",
    "extinguished_today": "red",
    "disabled_7d": "red",
    "canary_terminated": "red",
    "usertype_changed": "warn",
    "all_zero_jump": "warn",
    "legacy_unmapped_2pct": "warn",
    "legacy_snapshot_missing": "red",
    "gsc_gap_exceeded": "warn",
    "gsc_unverifiable": "warn",
    "run_missed": "red",
    "shadow_mode": "info",
    "db_size_cap": "red",
    "parse_error": "red"
  },
  "texts": {
    "stale_26h": "当前生效的 Trends 集合已超过 26 小时：带趋势条件的查询返回「数据陈旧」，不给加码建议",
    "not_published_low_coverage": "A 档覆盖率低于 80%，本批没有发布，上一个集合继续生效",
    "extinguished_today": "今天的直连采集已熄火（限流、验证页或同意墙），剩余单元未采",
    "disabled_7d": "7 天内熄火 3 次，直连已停用，人工重置后才恢复",
    "canary_terminated": "金丝雀已终止（验证码或熄火达到 2 次），不再运行",
    "usertype_changed": "Trends 返回的 userType 变了，会话可能被标成自动访问",
    "all_zero_jump": "全零序列的比例比前一天明显升高",
    "legacy_unmapped_2pct": "未映射的旧页点击超过旧页总点击的 2%，需要 RealShort 重跑旧页解析导出",
    "legacy_snapshot_missing": "没有可用的旧页解析快照，GSC 集合没有发布",
    "gsc_gap_exceeded": "GSC 明细与全站总量的缺口超过门槛，本轮只出描述性标签",
    "gsc_unverifiable": "GSC 全站总量取不到，覆盖无法核对，本轮只出描述性标签",
    "run_missed": "采集没有按时运行：02:30 UTC 仍没有当天的 Trends 批次，或 GSC 超过 4 小时没有新轮次",
    "shadow_mode": "发布开关关着：新集合只发成影子，智能体与联动不使用",
    "db_size_cap": "数据库容量达到上限，集合没有发布",
    "parse_error": "Trends 线上合同检查解析失败，接口可能改版，没有写入数值"
  },
